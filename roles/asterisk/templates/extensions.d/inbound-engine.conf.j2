; {{ ansible_managed }}
; Универсальный входящий движок.
;
; Этап 3 — заглушка: приветствие тенанта и очередь «main» (из базы тенанта).
; Этап 4 — маршрут из did_routes, график, праздники, чёрный список,
;          меню, очередь (см. tests/calls/bii.md).

[from-sbc]
; Звонки провайдера через SBC. ${EXTEN} — DID (Kamailio уже нормализовал номер).
exten => _X.,1,NoOp(Входящий: DID ${EXTEN}, CallerID ${CALLERID(num)}, тенант ${TENANT})
 same => n,Goto(engine-inbound,${EXTEN},1)

[engine-inbound]
exten => _X.,1,Set(CHANNEL(language)=${DEFAULT_LANGUAGE})
 same => n,Answer()
 same => n,Wait(0.5)
 same => n,Playback(tenants/${TENANT}/welcome)
 same => n,Queue(main,t,,,300)
 same => n,Hangup()

[from-operator]
; Звонки от операторов (через SBC) — этап 4 (переводы, служебные коды).
exten => _X.,1,Hangup(21)
